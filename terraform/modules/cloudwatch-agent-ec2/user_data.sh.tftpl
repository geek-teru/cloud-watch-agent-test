#!/bin/bash
set -euxo pipefail

# AL2023 は既定で journald のみで /var/log/messages が無いため rsyslog を入れる
dnf install -y rsyslog amazon-cloudwatch-agent
systemctl enable --now rsyslog

# auditd は AL2023 で既定で有効。念のため起動を保証する
systemctl enable --now auditd

# エージェントの設定。audit.log は root:root 0600 なので root で読む
# ヒアドキュメントはクォートして bash に展開させない（{instance_id} はエージェントが置換する）
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CONFIG'
{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/messages",
            "log_group_name": "${syslog_log_group_name}",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/audit/audit.log",
            "log_group_name": "${audit_log_group_name}",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
CONFIG

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
